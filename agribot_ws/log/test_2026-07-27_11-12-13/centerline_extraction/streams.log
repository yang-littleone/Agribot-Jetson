[6.180s] 6: +
[6.180s] 6: +  if (msg->poses.empty()) {
[6.181s] 6: +    RCLCPP_WARN(this->get_logger(), "收到空的中心线，当前帧不更新中心线");
[6.181s] 6: +    if (navigation_mode_ == NavigationMode::NEXT_ROW_REACQUIRE &&
[6.181s] 6: +      has_predicted_reacquire_path_)
[6.181s] 6: +    {
[6.181s] 6: +      center_line_ = predicted_reacquire_path_;
[6.182s] 6: +      has_center_line_ = true;
[6.182s] 6: +      has_measured_reacquire_path_ = false;
[6.182s] 6: +    } else {
[6.182s] 6: +      has_center_line_ = false;
[6.182s] 6: +    }
[6.182s] 6: +    return;
[6.182s] 6: +  }
[6.183s] 6: +
[6.183s] 6: +  if (navigation_mode_ == NavigationMode::NEXT_ROW_REACQUIRE) {
[6.183s] 6: +    measured_reacquire_path_ = *msg;
[6.183s] 6: +    has_measured_reacquire_path_ = true;
[6.183s] 6: +    if (has_predicted_reacquire_path_) {
[6.183s] 6: +      center_line_ = blend_reacquire_paths(
[6.184s] 6: +        predicted_reacquire_path_,
[6.184s] 6: +        measured_reacquire_path_,
[6.184s] 6: +        compute_reacquire_measured_weight());
[6.184s] 6: +    } else {
[6.184s] 6: +      center_line_ = measured_reacquire_path_;
[6.185s] 6: +    }
[6.185s] 6: +  } else {
[6.185s] 6: +    center_line_ = *msg;
[6.185s] 6: +  }
