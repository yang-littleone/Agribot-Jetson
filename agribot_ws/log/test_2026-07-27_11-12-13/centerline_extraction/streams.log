[6.242s] 6: +  double closest_distance = std::numeric_limits<double>::infinity();
[6.242s] 6: +  for (size_t index = 0; index < center_line_.poses.size(); ++index) {
[6.243s] 6: +    const auto & point = center_line_.poses[index].pose.position;
[6.243s] 6: +    const double distance = std::hypot(point.x - current_x_, point.y - current_y_);
