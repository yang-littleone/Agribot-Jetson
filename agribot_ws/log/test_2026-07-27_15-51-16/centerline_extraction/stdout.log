6: +void PIDController::confidence_callback(const std_msgs::msg::Float32::SharedPtr msg)
6: +{
6: +  corridor_confidence_ = std::clamp(static_cast<double>(msg->data), 0.0, 1.0);
6: +  has_corridor_confidence_ = true;
6: +  last_confidence_time_ = this->now();
6: +  has_confidence_timestamp_ = true;
