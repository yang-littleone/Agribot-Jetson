6: -double PIDController::limit_angular_command(
6: -    double desired_angular_speed, double angular_speed_limit, double dt)
6: -{
6: -    desired_angular_speed = std::clamp(
6: -        desired_angular_speed, -angular_speed_limit, angular_speed_limit);
6: -    if (std::abs(desired_angular_speed) < angular_command_deadband_)
6: -    {
6: -        desired_angular_speed = 0.0;
6: -    }
6: -
6: -    if (!has_last_angular_command_)
6: -    {
6: -        last_angular_command_ = 0.0;
6: -        has_last_angular_command_ = true;
6: -    }
6: -    if (max_angular_acceleration_ > 0.0)
6: -    {
6: -        const double max_delta =
6: -            max_angular_acceleration_ * std::clamp(dt, 0.001, 0.2);
6: -        desired_angular_speed = std::clamp(
6: -            desired_angular_speed,
6: -            last_angular_command_ - max_delta,
6: -            last_angular_command_ + max_delta);
6: -    }
6: -    // 死区只作用于 PID 的目标指令，不能再次作用于角加速度限幅后的中间值。
6: -    // 否则在高频控制下，当 max_angular_acceleration * dt 小于死区时，
6: -    // 每一帧刚建立的角速度都会被清零，车辆将永远无法开始转向。
6: -    desired_angular_speed = std::clamp(
6: -        desired_angular_speed, -angular_speed_limit, angular_speed_limit);
6: -    last_angular_command_ = desired_angular_speed;
6: -    return desired_angular_speed;
6: -}
