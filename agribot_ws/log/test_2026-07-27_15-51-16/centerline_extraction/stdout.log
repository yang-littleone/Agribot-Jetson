6: +double PIDController::compute_pid(
6: +  double error, double dt, double & integral, double & previous_error,
6: +  double kp, double ki, double kd)
6: +{
6: +  // 防止除零错误和时间间隔过大
6: +  if (dt <= 0.0 || dt > 1.0) {
6: +    dt = 0.05;
6: +  }
6: +
6: +  // 积分项
6: +  integral += error * dt;
6: +
6: +  // 微分项
6: +  double derivative = (error - previous_error) / dt;
6: +
6: +  // PID输出
6: +  double output = kp * error + ki * integral + kd * derivative;
6: +
6: +  // 更新previous_error
6: +  previous_error = error;
6: +
6: +  return output;
6: +}
