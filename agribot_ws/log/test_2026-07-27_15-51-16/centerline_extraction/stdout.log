6: +
6: +bool PIDController::is_path_end_reached() const
6: +{
6: +  if (!has_center_line_ || center_line_.poses.empty()) {
6: +    return false;
6: +  }
6: +
6: +  const auto & end = center_line_.poses.back().pose.position;
6: +  const double end_distance = std::hypot(end.x - current_x_, end.y - current_y_);
6: +  if (end_distance <= path_end_tolerance_) {
6: +    return true;
6: +  }
6: +
6: +  // 若车辆因横向偏差没有进入终点圆形容差，却已经越过终点横线，也必须停车。
6: +  // 否则 find_target_point() 会持续把最后一个点当目标，小车会在终点外继续前进。
6: +  if (center_line_.poses.size() < 2) {
6: +    return false;
6: +  }
6: +
6: +  // U 形/半圆路径的终点朝向可能与起点相反。若仅检查终点横线，起点会被
6: +  // 误判为已经越过终点。因此只有最近路径点已位于最后约 0.10 m 时，才允许
6: +  // 使用“越过终点横线”停车保护。
6: +  size_t closest_idx = 0;
6: +  double closest_distance = std::numeric_limits<double>::infinity();
6: +  for (size_t index = 0; index < center_line_.poses.size(); ++index) {
6: +    const auto & point = center_line_.poses[index].pose.position;
6: +    const double distance = std::hypot(point.x - current_x_, point.y - current_y_);
6: +    if (distance < closest_distance) {
6: +      closest_distance = distance;
6: +      closest_idx = index;
6: +    }
6: +  }
6: +  constexpr size_t kEndPointGateSamples = 3;
6: +  if (closest_idx + kEndPointGateSamples < center_line_.poses.size()) {
6: +    return false;
6: +  }
6: +
6: +  const auto & previous = center_line_.poses[center_line_.poses.size() - 2].pose.position;
6: +  const double tangent_x = end.x - previous.x;
6: +  const double tangent_y = end.y - previous.y;
6: +  const double tangent_length = std::hypot(tangent_x, tangent_y);
6: +  if (tangent_length < 1e-6) {
6: +    return false;
6: +  }
6: +
6: +  const double passed_distance =
6: +    ((current_x_ - end.x) * tangent_x + (current_y_ - end.y) * tangent_y) / tangent_length;
6: +  return passed_distance >= 0.0;
6: +}
6: +
6: +geometry_msgs::msg::PointStamped PIDController::find_target_point()
6: +{
6: +  geometry_msgs::msg::PointStamped target_point;
6: +  target_point.header.frame_id = center_line_.header.frame_id;
6: +  target_point.header.stamp = this->now();
6: +  target_path_heading_ = current_yaw_;
6: +  const double active_target_distance =
6: +    (navigation_mode_ ==
6: +    NavigationMode::U_TURN) ? headland_turn_target_distance_ : target_distance_;
6: +
6: +  if (center_line_.poses.size() == 1) {
6: +    target_point.point = center_line_.poses.front().pose.position;
6: +    return target_point;
6: +  }
6: +
6: +  // 1. 找到路径上离小车最近的点
6: +  size_t closest_idx = 0;
6: +  double min_dist = 1e9;
6: +  for (size_t i = 0; i < center_line_.poses.size(); ++i) {
6: +    const auto & p = center_line_.poses[i].pose.position;
6: +    double dx = p.x - current_x_;
6: +    double dy = p.y - current_y_;
6: +    double dist = std::hypot(dx, dy);
6: +    if (dist < min_dist) {
6: +      min_dist = dist;
6: +      closest_idx = i;
6: +    }
6: +  }
6: +
6: +  // 2. 从最近点开始，寻找距离小车目标距离的点
6: +  double accumulated_dist = 0.0;
6: +  for (size_t i = closest_idx; i < center_line_.poses.size() - 1; ++i) {
6: +    const auto & p1 = center_line_.poses[i].pose.position;
6: +    const auto & p2 = center_line_.poses[i + 1].pose.position;
6: +
6: +    // 计算路径段的长度
6: +    double segment_length = std::hypot(p2.x - p1.x, p2.y - p1.y);
6: +
6: +    // 如果加上这一段超过了目标距离，则在该段上插值
6: +    if (accumulated_dist + segment_length >= active_target_distance) {
6: +      double remaining_dist = active_target_distance - accumulated_dist;
6: +      double t = remaining_dist / segment_length;
6: +
6: +      target_point.point.x = p1.x + t * (p2.x - p1.x);
6: +      target_point.point.y = p1.y + t * (p2.y - p1.y);
6: +      target_point.point.z = 0.0;
6: +      target_path_heading_ = std::atan2(p2.y - p1.y, p2.x - p1.x);
