6: +PointCloudXYZPtr CornRowDetectorProjection::transform_cloud_to_base_frame(
6: +  PointCloudXYZPtr input_cloud, const std_msgs::msg::Header & header)
6: +{
6: +  PointCloudXYZPtr transformed_cloud(new PointCloudXYZ());
6: +
6: +  if (input_cloud->empty()) {
6: +    return transformed_cloud;
6: +  }
6: +
6: +  if (header.frame_id.empty() || header.frame_id == base_frame_) {
6: +    *transformed_cloud = *input_cloud;
6: +    transformed_cloud->header = input_cloud->header;
6: +    return transformed_cloud;
6: +  }
6: +
6: +  try {
6: +    geometry_msgs::msg::TransformStamped transform_msg =
6: +      tf_buffer_->lookupTransform(base_frame_, header.frame_id, tf2::TimePointZero);
6: +
6: +    tf2::Transform transform;
6: +    tf2::fromMsg(transform_msg.transform, transform);
6: +
6: +    transformed_cloud->points.reserve(input_cloud->points.size());
6: +    for (const auto & point : input_cloud->points) {
6: +      tf2::Vector3 point_in(point.x, point.y, point.z);
6: +      tf2::Vector3 point_out = transform * point_in;
6: +      transformed_cloud->points.emplace_back(point_out.x(), point_out.y(), point_out.z());
6: +    }
6: +
6: +    transformed_cloud->width = transformed_cloud->points.size();
6: +    transformed_cloud->height = 1;
6: +    transformed_cloud->is_dense = input_cloud->is_dense;
6: +    return transformed_cloud;
6: +  } catch (const tf2::TransformException & ex) {
6: +    RCLCPP_WARN_THROTTLE(
6: +      this->get_logger(), *this->get_clock(), 1000,
6: +      "Cannot transform point cloud from %s to %s: %s. Using raw cloud as fallback.",
6: +      header.frame_id.c_str(), base_frame_.c_str(), ex.what());
6: +    *transformed_cloud = *input_cloud;
6: +    return transformed_cloud;
6: +  }
6: +}
6: +
6: +PointCloudXYZPtr CornRowDetectorProjection::projection_point_cloud(PointCloudXYZPtr input_cloud)
6: +{
6: +  // Check if input cloud is empty
6: +  if (input_cloud->empty()) {
6: +    PointCloudXYZPtr empty_cloud(new PointCloudXYZ());
6: +    return empty_cloud;
6: +  }
6: +
6: +  // create a new point cloud, which will store the projected points
6: +  pcl::PointCloud<pcl::PointXY>::Ptr projected_cloud(new pcl::PointCloud<pcl::PointXY>);
6: +
6: +  for (const auto & point : input_cloud->points) {
6: +    // only keep x and y, project to xy plane
6: +    pcl::PointXY p;
6: +    p.x = point.x;
6: +    p.y = point.y;
6: +    projected_cloud->points.push_back(p);
6: +  }
6: +
6: +  projected_cloud->width = projected_cloud->points.size();
6: +  projected_cloud->height = 1;
6: +  projected_cloud->is_dense = true;
6: +
6: +  // Convert PointXY back to PointXYZ with a small offset in Z to make it visible in RVIZ
6: +  PointCloudXYZPtr final_cloud(new PointCloudXYZ());
6: +  final_cloud->header = input_cloud->header;
6: +  final_cloud->points.resize(projected_cloud->size());
6: +
6: +  for (size_t i = 0; i < projected_cloud->size(); ++i) {
6: +    pcl::PointXYZ point;
6: +    point.x = projected_cloud->points[i].x;
6: +    point.y = projected_cloud->points[i].y;
6: +    point.z = 0.01;     // Small offset in Z to make points visible in RVIZ
6: +    final_cloud->points[i] = point;
6: +  }
6: +
6: +  final_cloud->width = projected_cloud->width;
6: +  final_cloud->height = 1;
6: +  final_cloud->is_dense = true;
6: +
6: +  return final_cloud;
6: +}
