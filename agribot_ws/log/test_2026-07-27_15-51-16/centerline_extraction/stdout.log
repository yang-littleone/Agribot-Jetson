6: +float CornRowDetectorProjection::normalize_angle(float angle) const
6: +{
6: +  while (angle > static_cast<float>(M_PI)) {
6: +    angle -= 2.0f * static_cast<float>(M_PI);
6: +  }
6: +  while (angle < -static_cast<float>(M_PI)) {
6: +    angle += 2.0f * static_cast<float>(M_PI);
6: +  }
6: +  return angle;
6: +}
6: +
6: +float CornRowDetectorProjection::normalize_axis_angle(float angle) const
6: +{
6: +  angle = normalize_angle(angle);
6: +  const float half_pi = 0.5f * static_cast<float>(M_PI);
6: +  while (angle > half_pi) {
6: +    angle -= static_cast<float>(M_PI);
6: +  }
6: +  while (angle < -half_pi) {
6: +    angle += static_cast<float>(M_PI);
6: +  }
6: +  return angle;
6: +}
