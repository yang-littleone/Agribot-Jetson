6: +  this->get_parameter("lateral_kd", lateral_kd_);
6: +
6: +  this->get_parameter("heading_kp", heading_kp_);
6: +  this->get_parameter("heading_ki", heading_ki_);
6: +  this->get_parameter("heading_kd", heading_kd_);
6: +
6: +  this->get_parameter("debug_mode", debug_mode_);
6: +}
6: +
6: +void PIDController::center_line_callback(const nav_msgs::msg::Path::SharedPtr msg)
6: +{
6: +  last_centerline_time_ = this->now();
6: +  has_centerline_timestamp_ = true;
6: +  if (navigation_mode_ == NavigationMode::U_TURN) {
6: +    return;
6: +  }
6: +
6: +  if (msg->poses.empty()) {
6: +    RCLCPP_WARN(this->get_logger(), "收到空的中心线，当前帧不更新中心线");
6: +    if (navigation_mode_ == NavigationMode::NEXT_ROW_REACQUIRE &&
6: +      has_predicted_reacquire_path_)
6: +    {
6: +      center_line_ = predicted_reacquire_path_;
6: +      has_center_line_ = true;
6: +      has_measured_reacquire_path_ = false;
6: +    } else {
6: +      has_center_line_ = false;
6: +    }
6: +    return;
6: +  }
6: +
6: +  if (navigation_mode_ == NavigationMode::NEXT_ROW_REACQUIRE) {
6: +    measured_reacquire_path_ = *msg;
6: +    has_measured_reacquire_path_ = true;
6: +    if (has_predicted_reacquire_path_) {
6: +      center_line_ = blend_reacquire_paths(
6: +        predicted_reacquire_path_,
6: +        measured_reacquire_path_,
6: +        compute_reacquire_measured_weight());
6: +    } else {
6: +      center_line_ = measured_reacquire_path_;
6: +    }
6: +  } else {
6: +    center_line_ = *msg;
6: +  }
6: +  has_center_line_ = true;
6: +  if (!trial_started_ && navigation_mode_ == NavigationMode::ROW_FOLLOW) {
6: +    trial_started_ = true;
6: +    trial_start_time_ = this->now();
6: +    trial_distance_ = 0.0;
6: +    has_trial_previous_odom_ = false;
6: +    RCLCPP_INFO(this->get_logger(), "田间试验计程开始");
6: +  }
6: +  if (!use_quality_aware_control_ ||
6: +    !has_corridor_confidence_ ||
6: +    corridor_confidence_ >= confidence_low_threshold_)
6: +  {
6: +    last_valid_center_line_ = center_line_;
6: +    has_last_valid_center_line_ = true;
6: +    low_confidence_count_ = 0;
6: +  }
6: +  RCLCPP_DEBUG(this->get_logger(), "收到中心线（%zu个点）", center_line_.poses.size());
6: +}
