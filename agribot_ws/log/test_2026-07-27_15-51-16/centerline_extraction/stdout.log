6: -double PIDController::compute_confidence_factor() const
6: -{
6: -    if (navigation_mode_ == NavigationMode::U_TURN)
6: -    {
6: -        return 1.0;
6: -    }
6: -
6: -    if (navigation_mode_ == NavigationMode::NEXT_ROW_REACQUIRE)
6: -    {
6: -        return 1.0;
6: -    }
6: -
6: -    if (!use_quality_aware_control_)
6: -    {
6: -        return 1.0;
6: -    }
6: -
6: -    if (!has_corridor_confidence_)
6: -    {
6: -        return 1.0;
6: -    }
6: -
6: -    if (use_recovery_path_)
6: -    {
6: -        return confidence_min_speed_factor_;
6: -    }
6: -
6: -    return std::clamp(corridor_confidence_, confidence_min_speed_factor_, 1.0);
6: -}
