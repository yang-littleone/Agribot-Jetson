6: +  double sum = std::accumulate(distances.begin(), distances.end(), 0.0);
6: +  double mean = sum / distances.size();
6: +
6: +  double sq_sum = std::inner_product(distances.begin(), distances.end(), distances.begin(), 0.0);
6: +  double stdev = std::sqrt(sq_sum / distances.size() - mean * mean);
6: +
6: +  // 剔除异常值
6: +  nav_msgs::msg::Path filtered_path;
6: +  filtered_path.header = path.header;
6: +
6: +  // 第一个点总是保留
6: +  filtered_path.poses.push_back(path.poses[0]);
6: +
6: +  for (size_t i = 1; i < path.poses.size() - 1; i++) {
6: +    double dx = path.poses[i].pose.position.x - path.poses[i - 1].pose.position.x;
6: +    double dy = path.poses[i].pose.position.y - path.poses[i - 1].pose.position.y;
6: +    double distance = std::sqrt(dx * dx + dy * dy);
6: +
6: +    // 如果距离在正常范围内，则保留该点
6: +    if (std::abs(distance - mean) <= outlier_threshold_ * stdev) {
6: +      filtered_path.poses.push_back(path.poses[i]);
6: +    }
6: +  }
6: +
6: +  // 最后一个点总是保留
6: +  if (!path.poses.empty()) {
6: +    filtered_path.poses.push_back(path.poses.back());
6: +  }
