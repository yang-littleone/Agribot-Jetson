6: +      if (left && mean_y <= 0) {
6: +        continue;
6: +      }
6: +      if (!left && mean_y >= 0) {
6: +        continue;
6: +      }
6: +
6: +      float dist = std::abs(mean_y);
6: +      if (dist < best_dist) {
6: +        best_dist = dist;
6: +        best_cluster_idx = ci;
6: +        RCLCPP_DEBUG(
6: +          this->get_logger(), "Fallback1 selected cluster %zu: size=%zu, mean_y=%.3f", ci,
6: +          clusters[ci].size(), mean_y);
6: +      }
6: +    }
6: +  }
6: +
6: +  // Final fallback: any cluster closest to zero (ignore sign) if still not found
6: +  if (best_cluster_idx == -1) {
6: +    float best_dist = 1e6;
6: +    for (size_t ci = 0; ci < clusters.size(); ++ci) {
6: +      float sum_y = 0.0f;
6: +      for (auto idx : clusters[ci]) {
6: +        sum_y += cloud->points[idx].y;
6: +      }
6: +      float mean_y = sum_y / clusters[ci].size();
6: +      float dist = std::abs(mean_y);
6: +      if (dist < best_dist) {
6: +        best_dist = dist;
6: +        best_cluster_idx = ci;
6: +        RCLCPP_DEBUG(
6: +          this->get_logger(), "Final fallback selected cluster %zu: size=%zu, mean_y=%.3f", ci,
6: +          clusters[ci].size(), mean_y);
6: +      }
6: +    }
6: +  }
6: +
6: +  if (best_cluster_idx >= 0) {
6: +    for (auto idx : clusters[best_cluster_idx]) {
6: +      result->points.push_back(cloud->points[idx]);
6: +    }
6: +
6: +    // Log final selection
6: +    float sum_y = 0.0f;
6: +    for (auto idx : clusters[best_cluster_idx]) {
6: +      sum_y += cloud->points[idx].y;
6: +    }
6: +    float mean_y = sum_y / clusters[best_cluster_idx].size();
6: +    RCLCPP_DEBUG(
6: +      this->get_logger(), "Selected cluster %d: size=%zu, mean_y=%.3f", best_cluster_idx,
6: +      clusters[best_cluster_idx].size(), mean_y);
6: +  } else {
6: +    RCLCPP_WARN(
6: +      this->get_logger(), "No suitable cluster found on side=%s; returning empty result",
6: +      left ? "left" : "right");
6: +  }
6: +
6: +  result->width = result->points.size();
6: +  result->height = 1;
6: +  result->is_dense = true;
6: +  return result;
6: +}
