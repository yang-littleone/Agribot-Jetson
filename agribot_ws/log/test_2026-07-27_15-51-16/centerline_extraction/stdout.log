6: -bool PIDController::is_path_end_reached() const
6: -{
6: -    if (!has_center_line_ || center_line_.poses.empty())
6: -    {
6: -        return false;
6: -    }
6: -
6: -    const auto &end = center_line_.poses.back().pose.position;
6: -    const double end_distance = std::hypot(end.x - current_x_, end.y - current_y_);
6: -    if (end_distance <= path_end_tolerance_)
6: -    {
6: -        return true;
6: -    }
6: -
6: -    // 若车辆因横向偏差没有进入终点圆形容差，却已经越过终点横线，也必须停车。
6: -    // 否则 find_target_point() 会持续把最后一个点当目标，小车会在终点外继续前进。
6: -    if (center_line_.poses.size() < 2)
6: -    {
6: -        return false;
6: -    }
6: -
6: -    // U 形/半圆路径的终点朝向可能与起点相反。若仅检查终点横线，起点会被
6: -    // 误判为已经越过终点。因此只有最近路径点已位于最后约 0.10 m 时，才允许
6: -    // 使用“越过终点横线”停车保护。
6: -    size_t closest_idx = 0;
6: -    double closest_distance = std::numeric_limits<double>::infinity();
6: -    for (size_t index = 0; index < center_line_.poses.size(); ++index)
6: -    {
6: -        const auto &point = center_line_.poses[index].pose.position;
6: -        const double distance = std::hypot(point.x - current_x_, point.y - current_y_);
6: -        if (distance < closest_distance)
6: -        {
6: -            closest_distance = distance;
6: -            closest_idx = index;
6: -        }
6: -    }
6: -    constexpr size_t kEndPointGateSamples = 3;
6: -    if (closest_idx + kEndPointGateSamples < center_line_.poses.size())
6: -    {
6: -        return false;
6: -    }
6: -
6: -    const auto &previous = center_line_.poses[center_line_.poses.size() - 2].pose.position;
6: -    const double tangent_x = end.x - previous.x;
6: -    const double tangent_y = end.y - previous.y;
6: -    const double tangent_length = std::hypot(tangent_x, tangent_y);
6: -    if (tangent_length < 1e-6)
6: -    {
6: -        return false;
6: -    }
6: -
6: -    const double passed_distance =
6: -        ((current_x_ - end.x) * tangent_x + (current_y_ - end.y) * tangent_y) / tangent_length;
6: -    return passed_distance >= 0.0;
6: -}
