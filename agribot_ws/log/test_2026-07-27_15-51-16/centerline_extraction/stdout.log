6: -double PIDController::compute_lateral_error_to_path() const
6: -{
6: -    if (center_line_.poses.empty())
6: -    {
6: -        return 0.0;
6: -    }
6: -    if (center_line_.poses.size() == 1)
6: -    {
6: -        const auto &point = center_line_.poses.front().pose.position;
6: -        const double dx = point.x - current_x_;
6: -        const double dy = point.y - current_y_;
6: -        return dx * -std::sin(target_path_heading_) +
6: -               dy * std::cos(target_path_heading_);
6: -    }
6: -
6: -    double best_distance_squared = std::numeric_limits<double>::infinity();
6: -    double best_lateral_error = 0.0;
6: -    for (size_t index = 0; index + 1 < center_line_.poses.size(); ++index)
6: -    {
6: -        const auto &start = center_line_.poses[index].pose.position;
6: -        const auto &end = center_line_.poses[index + 1].pose.position;
6: -        const double segment_x = end.x - start.x;
6: -        const double segment_y = end.y - start.y;
6: -        const double segment_length_squared =
6: -            segment_x * segment_x + segment_y * segment_y;
6: -        if (segment_length_squared < 1e-12)
6: -        {
6: -            continue;
6: -        }
6: -
6: -        const double projection_fraction = std::clamp(
6: -            ((current_x_ - start.x) * segment_x +
6: -             (current_y_ - start.y) * segment_y) /
6: -                segment_length_squared,
6: -            0.0,
6: -            1.0);
6: -        const double projection_x =
6: -            start.x + projection_fraction * segment_x;
6: -        const double projection_y =
6: -            start.y + projection_fraction * segment_y;
6: -        const double path_from_vehicle_x = projection_x - current_x_;
6: -        const double path_from_vehicle_y = projection_y - current_y_;
6: -        const double distance_squared =
6: -            path_from_vehicle_x * path_from_vehicle_x +
6: -            path_from_vehicle_y * path_from_vehicle_y;
6: -        if (distance_squared >= best_distance_squared)
6: -        {
6: -            continue;
6: -        }
6: -
6: -        const double inverse_segment_length =
6: -            1.0 / std::sqrt(segment_length_squared);
6: -        const double left_normal_x =
6: -            -segment_y * inverse_segment_length;
6: -        const double left_normal_y =
6: -            segment_x * inverse_segment_length;
6: -        best_distance_squared = distance_squared;
6: -        best_lateral_error =
6: -            path_from_vehicle_x * left_normal_x +
6: -            path_from_vehicle_y * left_normal_y;
6: -    }
6: -    return best_lateral_error;
6: -}
