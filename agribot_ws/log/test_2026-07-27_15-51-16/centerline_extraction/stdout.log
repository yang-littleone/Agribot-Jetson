6: +
6: +nav_msgs::msg::Path CornRowDetectorProjection::spatial_smoothing(const nav_msgs::msg::Path & path)
6: +{
6: +  if (path.poses.size() < 3) {
6: +    return path;
6: +  }
6: +
6: +  nav_msgs::msg::Path smoothed_path;
6: +  smoothed_path.header = path.header;
6: +
6: +  // 第一个点保持不变
6: +  smoothed_path.poses.push_back(path.poses[0]);
6: +
6: +  // 对中间点进行平滑处理
6: +  for (size_t i = 1; i < path.poses.size() - 1; i++) {
6: +    geometry_msgs::msg::PoseStamped smoothed_pose = path.poses[i];
6: +
6: +    // 使用前后点进行平滑
6: +    smoothed_pose.pose.position.x = spatial_smooth_weight_ * path.poses[i].pose.position.x +
6: +      (1.0 - spatial_smooth_weight_) *
6: +      (path.poses[i - 1].pose.position.x + path.poses[i + 1].pose.position.x) / 2.0;
6: +
6: +    smoothed_pose.pose.position.y = spatial_smooth_weight_ * path.poses[i].pose.position.y +
6: +      (1.0 - spatial_smooth_weight_) *
6: +      (path.poses[i - 1].pose.position.y + path.poses[i + 1].pose.position.y) / 2.0;
6: +
6: +    // 重新计算方向
6: +    if (i < path.poses.size() - 1) {
6: +      double dx = smoothed_pose.pose.position.x - smoothed_path.poses.back().pose.position.x;
6: +      double dy = smoothed_pose.pose.position.y - smoothed_path.poses.back().pose.position.y;
6: +      double yaw = std::atan2(dy, dx);
6: +
6: +      tf2::Quaternion q;
6: +      q.setRPY(0, 0, yaw);
6: +      smoothed_pose.pose.orientation = tf2::toMsg(q);
6: +    }
6: +
6: +    smoothed_path.poses.push_back(smoothed_pose);
6: +  }
6: +
6: +  // 最后一个点保持不变
6: +  smoothed_path.poses.push_back(path.poses.back());
6: +
6: +  return smoothed_path;
6: +}
6: +
6: +nav_msgs::msg::Path CornRowDetectorProjection::temporal_smoothing(const nav_msgs::msg::Path & path)
6: +{
6: +  if (!enable_temporal_tracking_) {
6: +    path_history_.clear();
6: +    return path;
6: +  }
6: +
6: +  // 添加到历史记录
6: +  path_history_.push_back(path);
6: +
6: +  // 保持历史记录窗口大小
6: +  if (path_history_.size() > static_cast<size_t>(time_window_size_)) {
6: +    path_history_.pop_front();
6: +  }
6: +
6: +  if (path_history_.size() < 2) {
6: +    return path;
6: +  }
6: +
6: +  nav_msgs::msg::Path smoothed_path;
6: +  smoothed_path.header = path.header;
6: +
6: +  // 对每个点进行时间平滑
6: +  for (size_t i = 0; i < path.poses.size(); i++) {
6: +    geometry_msgs::msg::PoseStamped smoothed_pose = path.poses[i];
6: +    smoothed_pose.header = path.header;
6: +
6: +    double sum_x = 0.0, sum_y = 0.0;
6: +    size_t count = 0;
6: +
6: +    // 遍历历史记录中的对应点
6: +    for (const auto & history_path : path_history_) {
6: +      if (i < history_path.poses.size()) {
6: +        sum_x += history_path.poses[i].pose.position.x;
6: +        sum_y += history_path.poses[i].pose.position.y;
6: +        count++;
6: +      }
6: +    }
6: +
6: +    if (count > 0) {
6: +      smoothed_pose.pose.position.x = sum_x / count;
6: +      smoothed_pose.pose.position.y = sum_y / count;
6: +
6: +      // 重新计算方向
6: +      if (i > 0 && smoothed_path.poses.size() > 0) {
6: +        double dx = smoothed_pose.pose.position.x - smoothed_path.poses.back().pose.position.x;
6: +        double dy = smoothed_pose.pose.position.y - smoothed_path.poses.back().pose.position.y;
6: +        double yaw = std::atan2(dy, dx);
6: +
6: +        tf2::Quaternion q;
6: +        q.setRPY(0, 0, yaw);
6: +        smoothed_pose.pose.orientation = tf2::toMsg(q);
6: +      }
6: +    }
6: +
6: +    smoothed_path.poses.push_back(smoothed_pose);
6: +  }
6: +
6: +  return smoothed_path;
6: +}
