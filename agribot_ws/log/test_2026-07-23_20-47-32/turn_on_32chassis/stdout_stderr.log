7: +void TurnOn32Chassis::run()
7: +{
7: +  RCLCPP_INFO(this->get_logger(), "TurnOn32Chassis");
7: +  last_time_ = rclcpp::Node::now();
7: +
7: +  while (rclcpp::ok()) {
7: +    try {
7: +      current_time_ = rclcpp::Node::now();
7: +      sample_time_ = (current_time_ - last_time_).seconds();
7: +      // RCLCPP_INFO(this->get_logger(), "sample_time_: %f", sample_time_);
7: +      // 采样频率
7: +      if (TurnOn32Chassis::receive_row_serialdata() == true) {
7: +        // RCLCPP_INFO(this->get_logger(), "SAMPLING_FREQ: %f", 1 / sample_time_);
7: +
7: +        // 应用缩放系数
7: +        robot_vel_.X = robot_vel_.X * odom_x_scale_;
7: +        robot_vel_.Y = robot_vel_.Y * odom_y_scale;
7: +        if (robot_vel_.Z >= 0) {
7: +          robot_vel_.Z = robot_vel_.Z * odom_z_scale_positive;
7: +        } else {
7: +          robot_vel_.Z = robot_vel_.Z * odom_z_scale_negative;
7: +        }
7: +
7: +        robot_pos_.X += (robot_vel_.X * cos(robot_pos_.Z) - robot_vel_.Y * sin(robot_pos_.Z)) *
7: +          sample_time_;                                                                                               // Calculate the displacement in the X direction, unit: m //计算X方向的位移，单位：m
7: +        robot_pos_.Y += (robot_vel_.X * sin(robot_pos_.Z) + robot_vel_.Y * cos(robot_pos_.Z)) *
7: +          sample_time_;                                                                                               // Calculate the displacement in the Y direction, unit: m //计算Y方向的位移，单位：m
7: +        robot_pos_.Z += robot_vel_.Z * sample_time_;                                                                  // The angular displacement about the Z axis, in rad //绕Z轴的角位移，单位：rad
7: +
7: +        // 通过IMU绕三轴角速度与三轴加速度计算三轴姿态
7: +        Quaternion_Solution(
7: +          imu_msg_.angular_velocity.x, imu_msg_.angular_velocity.y, imu_msg_.angular_velocity.z,
7: +          imu_msg_.linear_acceleration.x, imu_msg_.linear_acceleration.y,
7: +          imu_msg_.linear_acceleration.z);
7: +
7: +        Publish_Odom();              // Pub the speedometer topic //发布里程计话题
7: +        Publish_ImuSensor();         // Pub the IMU topic //发布IMU话题
7: +        // Publish_Voltage();   // Pub the topic of power supply voltage //发布电源电压话题
7: +
7: +        last_time_ = current_time_;         // Record the time and use it to calculate the time interval //记录时间，用于计算时间间隔
7: +      }
7: +
7: +      rclcpp::spin_some(this->get_node_base_interface());
