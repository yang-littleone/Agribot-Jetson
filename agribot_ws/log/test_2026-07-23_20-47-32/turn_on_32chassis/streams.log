[6.814s] 7: +        robot_pos_.X += (robot_vel_.X * cos(robot_pos_.Z) - robot_vel_.Y * sin(robot_pos_.Z)) *
[6.814s] 7: +          sample_time_;                                                                                               // Calculate the displacement in the X direction, unit: m //计算X方向的位移，单位：m
[6.814s] 7: +        robot_pos_.Y += (robot_vel_.X * sin(robot_pos_.Z) + robot_vel_.Y * cos(robot_pos_.Z)) *
[6.814s] 7: +          sample_time_;                                                                                               // Calculate the displacement in the Y direction, unit: m //计算Y方向的位移，单位：m
[6.814s] 7: +        robot_pos_.Z += robot_vel_.Z * sample_time_;                                                                  // The angular displacement about the Z axis, in rad //绕Z轴的角位移，单位：rad
