[6.812s] 7: +      // 采样频率
[6.812s] 7: +      if (TurnOn32Chassis::receive_row_serialdata() == true) {
[6.812s] 7: +        // RCLCPP_INFO(this->get_logger(), "SAMPLING_FREQ: %f", 1 / sample_time_);
[6.812s] 7: +
[6.813s] 7: +        // 应用缩放系数
