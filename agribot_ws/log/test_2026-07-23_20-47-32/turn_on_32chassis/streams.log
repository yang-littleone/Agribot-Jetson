[6.813s] 7: +        robot_vel_.Y = robot_vel_.Y * odom_y_scale;
[6.813s] 7: +        if (robot_vel_.Z >= 0) {
[6.813s] 7: +          robot_vel_.Z = robot_vel_.Z * odom_z_scale_positive;
[6.813s] 7: +        } else {
[6.813s] 7: +          robot_vel_.Z = robot_vel_.Z * odom_z_scale_negative;
[6.814s] 7: +        }
